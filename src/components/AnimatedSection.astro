---
import type { HTMLTag } from 'astro/types';
interface Props {
  class?: string;
  group?: boolean;
  tag?: HTMLTag;
}

const { class: className = '', group = false, tag = 'section' } = Astro.props;
const Tag = tag;
---

<Tag
  class={className}
  {...group ? { 'data-animate-group': '' } : { 'data-animate': '' }}
>
  <slot />
</Tag>
