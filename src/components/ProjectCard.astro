---
interface Props {
  name: string;
  description: string;
  href: string;
  tags?: string[];
  status?: 'live' | 'in-progress';
  'data-animate-child'?: string;
}

const { name, description, href, tags = [], status = 'live' } = Astro.props;
const isLive = status === 'live';
---

<a
  href={href}
  target="_blank"
  rel="noopener noreferrer"
  data-animate-child
  class:list={[
    'block bg-bg-surface border border-border rounded-[var(--radius-card)] p-7 no-underline transition-[border-color,box-shadow,transform] duration-200',
    isLive ? 'cursor-pointer opacity-100 hover:border-accent-purple hover:[box-shadow:var(--shadow-glow-purple)] hover:-translate-y-0.5' : 'cursor-default opacity-50',
  ]}
>
  <div class="flex items-start justify-between gap-4 mb-3">
    <h3 class="text-text-primary text-[1.1rem] font-bold">{name}</h3>
    <span
      class:list={[
        'text-[0.7rem] font-semibold py-0.5 px-2.5 rounded-full whitespace-nowrap',
        isLive ? 'bg-accent-purple/15 text-accent-purple' : 'bg-[rgba(82,82,91,0.3)] text-text-muted',
      ]}
    >
      {isLive ? '● Live' : '⟳ In progress'}
    </span>
  </div>
  <p class="text-text-secondary text-[0.9rem] leading-relaxed mb-5">{description}</p>
  {tags.length > 0 && (
    <div class="flex flex-wrap gap-2">
      {tags.map((tag) => (
        <span class="text-[0.75rem] py-0.5 px-2.5 bg-bg-elevated border border-border rounded-full text-text-muted">
          {tag}
        </span>
      ))}
    </div>
  )}
</a>
