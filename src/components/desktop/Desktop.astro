---
import Icon from './Icon.astro';
import AnalyticsConsent from '../AnalyticsConsent.astro';
import Browser from './Browser.astro';
import Window from './Window.astro';
import { desktopCopy } from './copy';
import Welcome from '../views/Welcome.astro';
import Projects from '../views/Projects.astro';
import Blog from '../views/Blog.astro';
import About from '../views/About.astro';
import Community from '../views/Community.astro';
import HeroTerminal from '../HeroTerminal';
import Messenger from '../messenger/Messenger';
import { t, localizedPath, type Locale } from '../../i18n/index';
import { GITHUB_ORG } from '../../config';
interface Props { locale: Locale; activeApp: string; title: string; switcherLinks: { locale: string; label: string; href: string; active: boolean }[]; }
const { locale, activeApp, title, switcherLinks } = Astro.props;
const copy = desktopCopy[locale] ?? desktopCopy.en;
const apps = [
  { id: 'home', title: copy.welcome, icon: 'computer', path: '/' },
  { id: 'projects', title: t(locale, 'nav.projects'), icon: 'folder', path: '/projects' },
  { id: 'blog', title: t(locale, 'nav.blog'), icon: 'notebook', path: '/blog' },
  { id: 'get-involved', title: t(locale, 'nav.getInvolved'), icon: 'community', path: '/get-involved' },
  { id: 'about', title: t(locale, 'nav.about'), icon: 'globe', path: '/about' },
];
const utilities = [
  { id: 'browser', title: 'Internet Explorer', icon: 'browser' },
  { id: 'messenger', title: 'MSN Messenger', icon: 'messenger' },
  { id: 'terminal', title: copy.terminal, icon: 'terminal' },
  { id: 'settings', title: copy.settings, icon: 'settings' },
  { id: 'help', title: copy.help, icon: 'help' },
];
const tasks = [...apps.filter(app => app.id === activeApp), ...utilities, ...(activeApp === 'article' ? [{ id: 'article', title, icon: 'notebook' }] : [])];
---
<div class="os-desktop" lang={locale} data-desktop data-initial-app={activeApp} data-copy={JSON.stringify(copy)}>
  <a href={`#window-${activeApp}`} class="skip-link">{copy.skip}</a>
  <nav class="desktop-icons" aria-label={copy.desktop}>
    {apps.map(app => <a class="desktop-icon" href={localizedPath(app.path, locale)} data-app-link={app.id}><Icon name={app.icon} /><span>{app.title}</span></a>)}
    {utilities.filter(app => !['help', 'messenger'].includes(app.id)).map(app => <button type="button" class="desktop-icon js-only" data-open={app.id}><Icon name={app.icon} /><span>{app.title}</span></button>)}
  </nav>
  <div class="desktop-watermark" aria-hidden="true"><span>ExAI<span class="watermark-98">98</span></span><small>{copy.edition}</small><p>{copy.hint}</p></div>
  <aside class="desktop-note" aria-label={copy.note}><span aria-hidden="true">✳</span><strong>{copy.note}</strong><p>{copy.noteBody}</p><span class="note-signature">— your friends at ExAI</span></aside>
  <main id="desktop-workspace" class="desktop-workspace" aria-label={copy.windows}>
    {apps.filter(app => app.id === activeApp).map(app => <Window id={app.id} title={app.title} icon={app.icon} active copy={copy} address={localizedPath(app.path, locale)}>
      {app.id === 'home' && <Welcome locale={locale} />}
      {app.id === 'projects' && <Projects locale={locale} />}
      {app.id === 'blog' && <Blog locale={locale} />}
      {app.id === 'about' && <About locale={locale} />}
      {app.id === 'get-involved' && <Community locale={locale} />}
    </Window>)}
    <Window id="browser" title="Internet Explorer" icon="browser" copy={copy}>
      <Browser locale={locale} />
    </Window>
    <Window id="messenger" title="MSN Messenger" icon="messenger" copy={copy}>
      <Messenger locale={locale} client:visible />
    </Window>
    <Window id="terminal" title={copy.terminal} icon="terminal" copy={copy}>
      <p class="terminal-desktop-hint">{copy.terminalHint}</p>
      <HeroTerminal client:visible filesUrl={localizedPath('/terminal.json', locale)} locale={locale} embedded />
      <p class="terminal-desktop-hint">{copy.gameNote}</p>
    </Window>
    <Window id="settings" title={copy.settings} icon="settings" copy={copy}>
      <div class="settings-content">
        <Icon name="settings" size={48} /><h2>{copy.settings}</h2><p>{copy.preferences}</p>
        <fieldset><legend>{copy.settings}</legend>
          <label><input type="checkbox" data-preference="contrast" />{copy.contrast}</label>
          <label><input type="checkbox" data-preference="large" />{copy.large}</label>
          <label><input type="checkbox" data-preference="motion" />{copy.motion}</label>
          <label><input type="checkbox" data-preference="simple" />{copy.simple}</label>
        </fieldset>
        <fieldset><legend>{copy.language}</legend><div class="language-links">{switcherLinks.map(link => <a href={link.href} lang={link.locale} hreflang={link.locale} aria-current={link.active ? 'true' : undefined}>{link.label}</a>)}</div></fieldset>
      </div>
    </Window>
    <Window id="help" title={copy.help} icon="help" copy={copy}>
      <div class="settings-content"><Icon name="help" size={48} /><h2>{copy.help}</h2><p>{copy.helpBody}</p><p>{copy.moveHelp}</p><p>{copy.shortcuts}</p><button type="button" class="os-button" data-open="settings">{copy.settings}</button></div>
    </Window>
    {activeApp === 'article' && <Window id="article" title={title} icon="notebook" active copy={copy} address="exai://blog"><slot /></Window>}
  </main>
  <nav id="start-menu" class="start-menu" aria-label={copy.start} hidden>
    <div class="start-brand" aria-hidden="true">ExAI <strong>98</strong></div>
    <div class="start-menu-content">
      <p class="start-heading">{copy.edition}</p>
      {apps.map(app => <a href={localizedPath(app.path, locale)} data-app-link={app.id}><Icon name={app.icon} size={28} /><span>{app.title}</span></a>)}
      <hr />
      {utilities.map(app => <button type="button" data-open={app.id}><Icon name={app.icon} size={28} /><span>{app.title}</span></button>)}
      <hr /><a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer"><Icon name="globe" size={28} /><span>GitHub ↗</span></a>
      <div class="start-languages" aria-label={copy.language}>{switcherLinks.map(link => <a href={link.href} lang={link.locale} aria-current={link.active ? 'true' : undefined}>{link.label}</a>)}</div>
    </div>
  </nav>
  <footer class="os-taskbar">
    <button type="button" id="start-button" class="os-button start-button js-only" aria-expanded="false" aria-controls="start-menu"><Icon name="computer" size={26} /><strong>{copy.start}</strong></button>
    <button type="button" class="show-desktop js-only" data-show-desktop aria-label={copy.showDesktop} title={copy.showDesktop}><Icon name="computer" size={24} /></button>
    <nav class="taskbar-tasks" aria-label={copy.windows}>{tasks.map(app => <button type="button" data-task={app.id} hidden={activeApp !== app.id} class="os-button task-button" aria-controls={`window-${app.id}`} aria-pressed={activeApp === app.id}><Icon name={app.icon} size={20} /><span>{app.title}</span></button>)}</nav>
    <div class="system-tray"><AnalyticsConsent locale={locale} /><button type="button" data-open="messenger" class="js-only" aria-label="MSN Messenger" title="MSN Messenger"><Icon name="messenger" size={22} /></button><button type="button" data-open="settings" class="js-only" aria-label={copy.settings} title={copy.settings}><Icon name="settings" size={22} /></button><span class="tray-locale">{locale.toUpperCase()}</span><time id="desktop-clock" aria-label={locale === 'zh' ? '当前时间' : 'Local time'}>ExAI 98</time></div>
  </footer>
  <p class="sr-only" id="desktop-announcement" role="status" aria-live="polite" aria-atomic="true"></p>
  <noscript><p class="no-script-note">{copy.noScript}</p><style>.js-only,.os-window-controls,.os-menubar,.taskbar-tasks{display:none!important}.os-taskbar{position:static}.os-desktop{height:auto;overflow:visible}.desktop-workspace{position:relative;margin:20px}.os-window{position:relative;inset:auto;width:100%;height:auto;max-height:none}.os-window-body{overflow:visible}.desktop-icons{position:relative;display:flex;flex-wrap:wrap;width:auto}.desktop-note,.desktop-watermark{display:none}</style></noscript>
</div>
<script>
  import '../../scripts/desktop';
</script>
