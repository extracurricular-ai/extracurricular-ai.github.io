---
interface Props {
  title: string;
  description: string;
  icon: string;
  'data-animate-child'?: string;
}

const { title, description, icon } = Astro.props;
---

<div
  data-animate-child
  class="bg-bg-surface border border-border rounded-[var(--radius-card)] p-6"
>
  <div class="text-[1.75rem] mb-3">{icon}</div>
  <h3 class="text-text-primary text-base font-bold mb-1">{title}</h3>
  <p class="text-text-secondary text-sm leading-relaxed">{description}</p>
</div>
