---
import Icon from '../desktop/Icon.astro';
import { desktopCopy } from '../desktop/copy';
import { t, localizedPath, type Locale } from '../../i18n/index';
import { fetchProjects, localize } from '../../lib/github';
interface Props { locale: Locale }
const { locale } = Astro.props;
const copy = desktopCopy[locale];
const projects = (await fetchProjects()).slice(0, 3).map(p => localize(p, locale));
---
<div class="welcome-page">
  <div class="welcome-banner"><span>ExAI <b>98</b></span><span>{copy.edition}</span></div>
  <div class="welcome-hero">
    <div class="welcome-art" aria-hidden="true">
      <span class="pixel-spark spark-one">✦</span><Icon name="computer" size={152} /><span class="pixel-spark spark-two">✦</span>
      <span class="welcome-art-label">HELLO, WORLD!</span>
    </div>
    <div>
      <p class="os-eyebrow">{copy.intro}</p>
      <h1>{t(locale, 'home.heroTitle')}<br /><span>{t(locale, 'home.heroTitleAccent')}</span></h1>
      <p class="welcome-description">{t(locale, 'home.heroSubtitle')}</p>
      <div class="welcome-actions"><a class="os-button os-button-primary" href={localizedPath('/projects', locale)}>{copy.allSoftware} <span aria-hidden="true">→</span></a><a class="os-button" href={localizedPath('/get-involved', locale)}>{copy.community}</a></div>
    </div>
  </div>
  <div class="welcome-links">
    <a href={localizedPath('/projects', locale)}><Icon name="folder" /><span><strong>{t(locale, 'nav.projects')}</strong><small>{copy.explore}</small></span><span aria-hidden="true">↗</span></a>
    <a href={localizedPath('/blog', locale)}><Icon name="notebook" /><span><strong>{t(locale, 'nav.blog')}</strong><small>{copy.readBlog}</small></span><span aria-hidden="true">↗</span></a>
  </div>
  <div class="welcome-featured">
    <div class="os-section-heading"><h2>{t(locale, 'home.featuredTitle')}</h2><a href={localizedPath('/projects', locale)}>{t(locale, 'home.viewAllProjects')}</a></div>
    <div class="welcome-projects">{projects.map(project => <a href={project.href} target="_blank" rel="noopener noreferrer" class="welcome-project"><Icon name="folder" size={28} /><strong>{project.name}</strong><p>{project.description}</p><span>GitHub ↗</span></a>)}</div>
  </div>
  <aside class="welcome-tip"><Icon name="help" size={28} /><p><strong>{copy.tip}</strong> {copy.tipBody}</p></aside>
</div>
