---
import { GITHUB_ORG } from '../config';
const year = new Date().getFullYear();
---

<footer class="border-t border-border py-10">
  <div class="max-w-[1280px] mx-auto px-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <span class="gradient-text font-extrabold text-[1.1rem]">ExAI</span>
      <p class="text-text-muted text-[0.8rem] mt-1">
        &copy; {year} Extracurricular AI. Open source, always.
      </p>
    </div>
    <nav class="flex gap-6 flex-wrap">
      <a href="/about" class="text-text-muted no-underline text-sm transition-colors duration-200 hover:text-text-secondary">About</a>
      <a href="/projects" class="text-text-muted no-underline text-sm transition-colors duration-200 hover:text-text-secondary">Projects</a>
      <a href="/get-involved" class="text-text-muted no-underline text-sm transition-colors duration-200 hover:text-text-secondary">Get Involved</a>
      <a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer" class="text-text-muted no-underline text-sm transition-colors duration-200 hover:text-accent-purple">GitHub ↗</a>
    </nav>
  </div>
</footer>
