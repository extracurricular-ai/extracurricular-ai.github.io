---
import { GITHUB_ORG } from '../config';
const year = new Date().getFullYear();
---

<footer style="border-top: 1px solid var(--color-border); margin-top: auto; padding: 2.5rem 0;">
  <div class="container" style="display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 1rem;">
    <div>
      <span class="gradient-text" style="font-weight: 800; font-size: 1.1rem;">ExAI</span>
      <p style="color: var(--color-text-muted); font-size: 0.8rem; margin-top: 0.25rem;">
        © {year} Extracurricular AI. Open source, always.
      </p>
    </div>
    <nav style="display: flex; gap: 1.5rem; flex-wrap: wrap;">
      <a href="/about" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.875rem; transition: color 0.2s;" onmouseover="this.style.color='var(--color-text-secondary)'" onmouseout="this.style.color='var(--color-text-muted)'">About</a>
      <a href="/projects" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.875rem; transition: color 0.2s;" onmouseover="this.style.color='var(--color-text-secondary)'" onmouseout="this.style.color='var(--color-text-muted)'">Projects</a>
      <a href="/get-involved" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.875rem; transition: color 0.2s;" onmouseover="this.style.color='var(--color-text-secondary)'" onmouseout="this.style.color='var(--color-text-muted)'">Get Involved</a>
      <a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer" style="color: var(--color-text-muted); text-decoration: none; font-size: 0.875rem; transition: color 0.2s;" onmouseover="this.style.color='var(--color-accent-purple)'" onmouseout="this.style.color='var(--color-text-muted)'">GitHub ↗</a>
    </nav>
  </div>
</footer>
