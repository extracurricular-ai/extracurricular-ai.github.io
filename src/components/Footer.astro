---
import { GITHUB_ORG } from '../config';
import { localizedPath, t, type Locale } from '../i18n/index';

interface Props { locale?: string; }
const { locale = 'en' } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="border-t border-border py-10">
  <div class="max-w-[1280px] mx-auto px-6 flex flex-wrap items-center justify-between gap-4">
    <div>
      <a href={localizedPath('/', locale as Locale)} class="flex items-center gap-2 no-underline mb-1">
        <img src="/logo.png" alt="ExAI" class="h-7 w-7 object-contain" />
        <span class="gradient-text font-extrabold text-[1.1rem]">ExAI</span>
      </a>
      <p class="text-text-muted text-[0.8rem] mt-1">
        &copy; {year} {t(locale, 'footer.copyright')}
      </p>
    </div>
    <nav class="flex gap-6 flex-wrap">
      <a href={localizedPath('/about', locale as Locale)} class="text-text-muted no-underline text-sm transition-colors duration-200 hover:text-text-secondary">{t(locale, 'footer.about')}</a>
      <a href={localizedPath('/projects', locale as Locale)} class="text-text-muted no-underline text-sm transition-colors duration-200 hover:text-text-secondary">{t(locale, 'footer.projects')}</a>
      <a href={localizedPath('/get-involved', locale as Locale)} class="text-text-muted no-underline text-sm transition-colors duration-200 hover:text-text-secondary">{t(locale, 'footer.getInvolved')}</a>
      <a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer" class="text-text-muted no-underline text-sm transition-colors duration-200 hover:text-accent-purple">GitHub ↗</a>
    </nav>
  </div>
</footer>
