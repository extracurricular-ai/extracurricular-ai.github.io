---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedSection from '../components/AnimatedSection.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ValuePill from '../components/ValuePill.astro';
import { GITHUB_ORG, GITHUB_REPO } from '../config';
---

<BaseLayout
  title="Home"
  description="Extracurricular AI — a space for builders who learn by shipping."
>
  <!-- HERO -->
  <section
    data-animate
    style="
      min-height: 100vh;
      display: flex;
      align-items: center;
      padding-top: 5rem;
      position: relative;
      overflow: hidden;
    "
  >
    <!-- background glow -->
    <div style="
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(124, 58, 237, 0.12) 0%, transparent 70%);
      pointer-events: none;
    "></div>

    <div class="container" style="position: relative; text-align: center;">
      <div style="
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        background: rgba(168, 85, 247, 0.1);
        border: 1px solid rgba(168, 85, 247, 0.25);
        border-radius: 9999px;
        padding: 0.35rem 1rem;
        font-size: 0.8rem;
        font-weight: 600;
        color: var(--color-accent-purple);
        margin-bottom: 2rem;
        letter-spacing: 0.05em;
        text-transform: uppercase;
      ">
        Open Collective · Open Source
      </div>

      <h1 style="
        font-size: clamp(2.75rem, 8vw, 5.5rem);
        font-weight: 900;
        line-height: 1.05;
        letter-spacing: -0.03em;
        margin-bottom: 1.5rem;
        color: var(--color-text-primary);
      ">
        Building AI,<br /><span class="gradient-text">in the open.</span>
      </h1>

      <p style="
        font-size: clamp(1rem, 2.5vw, 1.25rem);
        color: var(--color-text-secondary);
        max-width: 600px;
        margin: 0 auto 2.5rem;
        line-height: 1.7;
      ">
        An open collective exploring AI through hands-on experimentation —
        a space for builders who learn by shipping.
      </p>

      <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
        <a href="/projects" class="btn-primary">See Projects</a>
        <a href="/get-involved" class="btn-ghost">Get Involved</a>
      </div>
    </div>
  </section>

  <!-- STATS STRIP -->
  <AnimatedSection style="border-top: 1px solid var(--color-border); border-bottom: 1px solid var(--color-border); padding: 2rem 0;">
    <div class="container">
      <div style="display: flex; flex-wrap: wrap; justify-content: center; gap: 3rem;">
        {[
          { label: 'Open Source', value: '100%' },
          { label: 'Community Driven', value: '∞' },
          { label: 'Free Tools', value: 'Always' },
          { label: 'Learning by Doing', value: '⟶' },
        ].map(({ label, value }) => (
          <div style="text-align: center;">
            <div style="font-size: 1.75rem; font-weight: 900; color: var(--color-accent-purple);">{value}</div>
            <div style="font-size: 0.8rem; color: var(--color-text-muted); margin-top: 0.25rem; text-transform: uppercase; letter-spacing: 0.05em;">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </AnimatedSection>

  <!-- FEATURED PROJECT -->
  <AnimatedSection style="padding: var(--spacing-section) 0;">
    <div class="container">
      <div style="margin-bottom: 2.5rem;">
        <p style="color: var(--color-accent-purple); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.75rem;">Featured Project</p>
        <h2 style="font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.75rem;">What we're building</h2>
        <p style="color: var(--color-text-secondary); max-width: 520px;">Real tools, shipped in the open. Here's what the collective is working on right now.</p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 480px), 1fr)); gap: 1.25rem;" data-animate-group>
        <ProjectCard
          name="Open Deep Research"
          description="An open replication of OpenAI's Deep Research — parallel background tasks, real-time streaming UI, and a multi-agent pipeline. Built fast, shipped open."
          href={GITHUB_REPO}
          tags={["Python", "Preact", "AI Agents", "Streaming"]}
          status="live"
        />
      </div>
      <div style="margin-top: 2rem;">
        <a href="/projects" class="btn-ghost">View all projects →</a>
      </div>
    </div>
  </AnimatedSection>

  <!-- VALUES -->
  <AnimatedSection style="padding: var(--spacing-section) 0; background: var(--color-bg-surface);" group>
    <div class="container">
      <div style="margin-bottom: 2.5rem; text-align: center;">
        <h2 style="font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.75rem;">What we stand for</h2>
        <p style="color: var(--color-text-secondary); max-width: 480px; margin-inline: auto;">The principles that guide everything we build and how we build it.</p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 1rem;">
        <ValuePill icon="⚡" title="Learn by Shipping" description="The fastest way to learn AI is to build something real and put it in front of people." />
        <ValuePill icon="🔓" title="Open Source" description="Everything we make is public. No paywalls, no black boxes, no gatekeeping." />
        <ValuePill icon="🤝" title="Community First" description="We build together. Every contributor matters, regardless of skill level." />
        <ValuePill icon="🛠️" title="Free Tools" description="Our tools are free for the community, always. That's non-negotiable." />
      </div>
    </div>
  </AnimatedSection>

  <!-- GET INVOLVED CTA -->
  <AnimatedSection style="padding: var(--spacing-section) 0;">
    <div class="container" style="text-align: center;">
      <div style="
        background: linear-gradient(135deg, rgba(124, 58, 237, 0.12), rgba(34, 211, 238, 0.08));
        border: 1px solid var(--color-border-accent);
        border-radius: 1.25rem;
        padding: clamp(2rem, 6vw, 4rem);
      ">
        <h2 style="font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 1rem;">
          Ready to <span class="gradient-text">build something?</span>
        </h2>
        <p style="color: var(--color-text-secondary); max-width: 480px; margin: 0 auto 2rem; line-height: 1.7;">
          Join the collective. Open a PR, share an idea, or just say hi on GitHub.
        </p>
        <div style="display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap;">
          <a href="/get-involved" class="btn-primary">Get Involved</a>
          <a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer" class="btn-ghost">GitHub ↗</a>
        </div>
      </div>
    </div>
  </AnimatedSection>
</BaseLayout>
