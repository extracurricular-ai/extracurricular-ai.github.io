---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedSection from '../components/AnimatedSection.astro';
import ProjectCard from '../components/ProjectCard.astro';
import ValuePill from '../components/ValuePill.astro';
import { GITHUB_ORG, GITHUB_REPO } from '../config';
---

<BaseLayout
  title="Home"
  description="Extracurricular AI — a space for builders who learn by shipping."
>
  <!-- HERO -->
  <section class="min-h-screen flex items-center pt-20 relative overflow-hidden animate-fade-up">
    <!-- background glow — radial-gradient must stay inline -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(124, 58, 237, 0.12) 0%, transparent 70%);"
    ></div>

    <div class="max-w-[1280px] mx-auto px-6 relative text-center">
      <div class="inline-flex items-center gap-2 bg-accent-purple/10 border border-accent-purple/25 rounded-full px-4 py-1.5 text-[0.8rem] font-semibold text-accent-purple mb-8 uppercase tracking-[0.05em]">
        Open Collective · Open Source
      </div>

      <h1
        class="font-black leading-[1.05] tracking-[-0.03em] mb-6 text-text-primary"
        style="font-size: clamp(2.75rem, 8vw, 5.5rem);"
      >
        Building AI,<br /><span class="gradient-text">in the open.</span>
      </h1>

      <p
        class="text-text-secondary max-w-[600px] mx-auto mb-10 leading-[1.7]"
        style="font-size: clamp(1rem, 2.5vw, 1.25rem);"
      >
        An open collective exploring AI through hands-on experimentation —
        a space for builders who learn by shipping.
      </p>

      <div class="flex gap-4 justify-center flex-wrap">
        <a href="/projects" class="btn-primary">See Projects</a>
        <a href="/get-involved" class="btn-ghost">Get Involved</a>
      </div>
    </div>
  </section>

  <!-- STATS STRIP -->
  <AnimatedSection class="border-t border-b border-border py-8">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="flex flex-wrap justify-center gap-12">
        {[
          { label: 'Open Source', value: '100%' },
          { label: 'Community Driven', value: '∞' },
          { label: 'Free Tools', value: 'Always' },
          { label: 'Learning by Doing', value: '⟶' },
        ].map(({ label, value }) => (
          <div class="text-center">
            <div class="text-[1.75rem] font-black text-accent-purple">{value}</div>
            <div class="text-[0.8rem] text-text-muted mt-1 uppercase tracking-[0.05em]">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </AnimatedSection>

  <!-- FEATURED PROJECT -->
  <AnimatedSection class="py-6">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="mb-10">
        <p class="text-accent-purple text-[0.8rem] font-semibold uppercase tracking-[0.08em] mb-3">Featured Project</p>
        <h2 class="font-extrabold tracking-[-0.02em] mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">What we're building</h2>
        <p class="text-text-secondary max-w-[520px]">Real tools, shipped in the open. Here's what the collective is working on right now.</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,480px),1fr))] gap-5" data-animate-group>
        <ProjectCard
          name="Open Deep Research"
          description="An open replication of OpenAI's Deep Research — parallel background tasks, real-time streaming UI, and a multi-agent pipeline. Built fast, shipped open."
          href={GITHUB_REPO}
          tags={["Python", "Preact", "AI Agents", "Streaming"]}
          status="live"
        />
      </div>
      <div class="mt-8">
        <a href="/projects" class="btn-ghost">View all projects →</a>
      </div>
    </div>
  </AnimatedSection>

  <!-- VALUES -->
  <AnimatedSection class="py-6 bg-bg-surface" group>
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="mb-10 text-center">
        <h2 class="font-extrabold tracking-[-0.02em] mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">What we stand for</h2>
        <p class="text-text-secondary max-w-[480px] mx-auto">The principles that guide everything we build and how we build it.</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4">
        <ValuePill icon="⚡" title="Learn by Shipping" description="The fastest way to learn AI is to build something real and put it in front of people." />
        <ValuePill icon="🔓" title="Open Source" description="Everything we make is public. No paywalls, no black boxes, no gatekeeping." />
        <ValuePill icon="🤝" title="Community First" description="We build together. Every contributor matters, regardless of skill level." />
        <ValuePill icon="🛠️" title="Free Tools" description="Our tools are free for the community, always. That's non-negotiable." />
      </div>
    </div>
  </AnimatedSection>

  <!-- GET INVOLVED CTA -->
  <AnimatedSection class="py-16">
    <div class="max-w-[1280px] mx-auto px-6 text-center">
      <div
        class="border border-[var(--color-border-accent)] rounded-[1.25rem]"
        style="background: linear-gradient(135deg, rgba(124, 58, 237, 0.12), rgba(34, 211, 238, 0.08)); padding: clamp(2rem, 6vw, 4rem);"
      >
        <h2 class="font-extrabold tracking-[-0.02em] mb-4" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
          Ready to <span class="gradient-text">build something?</span>
        </h2>
        <p class="text-text-secondary max-w-[480px] mx-auto mb-8 leading-[1.7]">
          Join the collective. Open a PR, share an idea, or just say hi on GitHub.
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a href="/get-involved" class="btn-primary">Get Involved</a>
          <a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer" class="btn-ghost">GitHub ↗</a>
        </div>
      </div>
    </div>
  </AnimatedSection>
</BaseLayout>
