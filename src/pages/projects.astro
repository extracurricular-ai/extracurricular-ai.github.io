---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedSection from '../components/AnimatedSection.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { GITHUB_ORG, GITHUB_REPO } from '../config';
---

<BaseLayout
  title="Projects"
  description="Open source AI projects built by the Extracurricular AI collective."
>
  <!-- PAGE HERO -->
  <section class="pt-40 pb-20 relative overflow-hidden animate-fade-up">
    <!-- radial-gradient background must stay inline -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(34, 211, 238, 0.07) 0%, transparent 70%);"
    ></div>
    <div class="max-w-[1280px] mx-auto px-6 relative">
      <p class="text-accent-cyan text-[0.8rem] font-semibold uppercase tracking-[0.08em] mb-4">Open Source Projects</p>
      <h1 class="font-black tracking-[-0.03em] mb-6" style="font-size: clamp(2.25rem, 6vw, 4rem);">
        What we're <span class="gradient-text">building</span>
      </h1>
      <p class="text-text-secondary max-w-[560px] leading-[1.75]" style="font-size: clamp(1rem, 2vw, 1.2rem);">
        Real tools, shipped in the open. Everything below is free to use, fork, and contribute to.
      </p>
    </div>
  </section>

  <!-- LIVE PROJECTS -->
  <AnimatedSection class="py-6">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="text-[1.1rem] font-semibold text-text-muted uppercase tracking-[0.08em] mb-6">
        Live Projects
      </h2>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,480px),1fr))] gap-5" data-animate-group>
        <ProjectCard
          name="Open Deep Research"
          description="An open replication of OpenAI's Deep Research. Features parallel background tasks, real-time streaming UI with Preact, and a full multi-agent pipeline. Built fast, shipped open — because that's how we learn."
          href={GITHUB_REPO}
          tags={["Python", "Preact", "AI Agents", "Streaming", "Multi-Agent"]}
          status="live"
        />
      </div>
    </div>
  </AnimatedSection>

  <!-- IN PROGRESS -->
  <AnimatedSection class="py-6">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="text-[1.1rem] font-semibold text-text-muted uppercase tracking-[0.08em] mb-6">
        Coming Soon
      </h2>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,480px),1fr))] gap-5" data-animate-group>
        <ProjectCard
          name="More projects in progress..."
          description="The collective is always experimenting. Watch the GitHub org for what's brewing next."
          href={GITHUB_ORG}
          tags={["TBD"]}
          status="in-progress"
        />
      </div>
    </div>
  </AnimatedSection>

  <!-- CONTRIBUTE CTA -->
  <AnimatedSection class="py-16 bg-bg-surface">
    <div class="max-w-[1280px] mx-auto px-6 text-center">
      <h2 class="font-extrabold tracking-[-0.02em] mb-4" style="font-size: clamp(1.5rem, 3vw, 2.25rem);">
        Want to build <span class="gradient-text">something new?</span>
      </h2>
      <p class="text-text-secondary max-w-[440px] mx-auto mb-8 leading-[1.7]">
        Open an issue, propose a project, or just jump into an existing one. All contributions welcome.
      </p>
      <a href="/get-involved" class="btn-primary">Get Involved →</a>
    </div>
  </AnimatedSection>
</BaseLayout>
