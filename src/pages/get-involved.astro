---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedSection from '../components/AnimatedSection.astro';
import { GITHUB_ORG, GITHUB_REPO, GITHUB_REPO_DISCUSSIONS, GITHUB_REPO_ISSUES } from '../config';
---

<BaseLayout
  title="Get Involved"
  description="Join the Extracurricular AI collective — contribute to open source AI projects, share ideas, and build with us."
>
  <!-- PAGE HERO -->
  <section data-animate style="padding: 10rem 0 5rem; text-align: center; position: relative; overflow: hidden;">
    <div style="
      position: absolute; inset: 0;
      background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(168, 85, 247, 0.1) 0%, transparent 70%);
      pointer-events: none;
    "></div>
    <div class="container" style="position: relative;">
      <p style="color: var(--color-accent-purple); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 1rem;">Join the Collective</p>
      <h1 style="font-size: clamp(2.25rem, 6vw, 4rem); font-weight: 900; letter-spacing: -0.03em; margin-bottom: 1.5rem;">
        Build with <span class="gradient-text">us</span>
      </h1>
      <p style="color: var(--color-text-secondary); font-size: clamp(1rem, 2vw, 1.2rem); max-width: 560px; margin-inline: auto; line-height: 1.75;">
        No applications, no gatekeeping. If you want to build AI tools in the open, you're already in.
      </p>
    </div>
  </section>

  <!-- WAYS TO CONTRIBUTE -->
  <AnimatedSection style="padding: var(--spacing-section) 0;" group>
    <div class="container">
      <div style="margin-bottom: 2.5rem;">
        <h2 style="font-size: clamp(1.75rem, 4vw, 2.5rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 0.75rem;">Ways to contribute</h2>
        <p style="color: var(--color-text-secondary); max-width: 480px;">Every skill level welcome. Pick your entry point.</p>
      </div>
      <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 1.25rem;">
        {[
          {
            icon: '🔧',
            title: 'Build with us',
            description: 'Open a PR on an existing project, tackle an open issue, or propose something entirely new.',
            cta: 'Browse GitHub',
            href: GITHUB_ORG,
            external: true,
          },
          {
            icon: '💡',
            title: 'Share an idea',
            description: 'Have an idea for a project or feature? Open a discussion or issue on GitHub.',
            cta: 'Open a Discussion',
            href: GITHUB_REPO_DISCUSSIONS,
            external: true,
          },
          {
            icon: '📣',
            title: 'Spread the word',
            description: 'Star the repos, share with your network, or write about what we&apos;re building.',
            cta: 'Star on GitHub',
            href: GITHUB_REPO,
            external: true,
          },
        ].map(({ icon, title, description, cta, href, external }) => (
          <div
            data-animate-child
            style="background: var(--color-bg-surface); border: 1px solid var(--color-border); border-radius: var(--radius-card); padding: 1.75rem; display: flex; flex-direction: column;"
          >
            <div style="font-size: 2rem; margin-bottom: 1rem;">{icon}</div>
            <h3 style="color: var(--color-text-primary); font-size: 1.1rem; font-weight: 700; margin-bottom: 0.5rem;">{title}</h3>
            <p style="color: var(--color-text-secondary); font-size: 0.9rem; line-height: 1.6; flex: 1; margin-bottom: 1.5rem;">{description}</p>
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              class="btn-ghost"
              style="align-self: flex-start; padding: 0.5rem 1.25rem; font-size: 0.875rem;"
            >
              {cta} {external ? '↗' : '→'}
            </a>
          </div>
        ))}
      </div>
    </div>
  </AnimatedSection>

  <!-- OPEN ISSUES -->
  <AnimatedSection style="padding: var(--spacing-section) 0; background: var(--color-bg-surface);">
    <div class="container">
      <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 4rem; align-items: center;">
        <div>
          <p style="color: var(--color-accent-purple); font-size: 0.8rem; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 0.75rem;">Good first issues</p>
          <h2 style="font-size: clamp(1.5rem, 3vw, 2.25rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 1rem;">
            Jump right in
          </h2>
          <p style="color: var(--color-text-secondary); line-height: 1.8; margin-bottom: 2rem;">
            Check out open issues on our repos — we tag beginner-friendly tasks so you can find your footing without any friction.
          </p>
          <a
            href={GITHUB_REPO_ISSUES}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            View Open Issues ↗
          </a>
        </div>
        <div style="
          background: var(--color-bg-elevated);
          border: 1px solid var(--color-border);
          border-radius: 1rem;
          padding: 1.5rem;
          font-family: var(--font-mono);
          font-size: 0.82rem;
          line-height: 1.9;
        ">
          <p style="color: var(--color-text-muted); margin-bottom: 0.5rem;"># how to contribute</p>
          <p><span style="color: var(--color-accent-cyan);">1.</span> <span style="color: var(--color-text-secondary);">Fork the repo</span></p>
          <p><span style="color: var(--color-accent-cyan);">2.</span> <span style="color: var(--color-text-secondary);">Create a branch</span></p>
          <p><span style="color: var(--color-accent-cyan);">3.</span> <span style="color: var(--color-text-secondary);">Make your changes</span></p>
          <p><span style="color: var(--color-accent-cyan);">4.</span> <span style="color: var(--color-text-secondary);">Open a PR</span></p>
          <p><span style="color: var(--color-accent-cyan);">5.</span> <span style="color: var(--color-accent-purple);">Ship it 🚀</span></p>
        </div>
      </div>
    </div>
  </AnimatedSection>

  <!-- FINAL CTA -->
  <AnimatedSection style="padding: var(--spacing-section) 0; text-align: center;">
    <div class="container">
      <h2 style="font-size: clamp(1.75rem, 4vw, 2.75rem); font-weight: 800; letter-spacing: -0.02em; margin-bottom: 1rem;">
        The door is <span class="gradient-text">always open.</span>
      </h2>
      <p style="color: var(--color-text-secondary); max-width: 440px; margin: 0 auto 2rem; line-height: 1.7;">
        You don't need permission to contribute. Just show up, build something, and share it.
      </p>
      <a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer" class="btn-primary">
        Start on GitHub ↗
      </a>
    </div>
  </AnimatedSection>
</BaseLayout>

<style>
  @media (max-width: 768px) {
    .two-col { grid-template-columns: 1fr !important; }
  }
</style>
