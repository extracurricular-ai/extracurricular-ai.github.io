---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedSection from '../components/AnimatedSection.astro';
import { GITHUB_ORG, GITHUB_REPO, GITHUB_REPO_DISCUSSIONS, GITHUB_REPO_ISSUES } from '../config';
---

<BaseLayout
  title="Get Involved"
  description="Join the Extracurricular AI collective — contribute to open source AI projects, share ideas, and build with us."
>
  <!-- PAGE HERO -->
  <section class="pt-40 pb-20 text-center relative overflow-hidden animate-fade-up">
    <!-- radial-gradient background must stay inline -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(42, 181, 165, 0.1) 0%, transparent 70%);"
    ></div>
    <div class="max-w-[1280px] mx-auto px-6 relative">
      <p class="text-accent-purple text-[0.8rem] font-semibold uppercase tracking-[0.08em] mb-4">Join the Collective</p>
      <h1 class="font-black tracking-[-0.03em] mb-6" style="font-size: clamp(2.25rem, 6vw, 4rem);">
        Build with <span class="gradient-text">us</span>
      </h1>
      <p class="text-text-secondary max-w-[560px] mx-auto leading-[1.75]" style="font-size: clamp(1rem, 2vw, 1.2rem);">
        No applications, no gatekeeping. If you want to build AI tools in the open, you're already in.
      </p>
    </div>
  </section>

  <!-- WAYS TO CONTRIBUTE -->
  <AnimatedSection class="py-6" group>
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="mb-10">
        <h2 class="font-extrabold tracking-[-0.02em] mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">Ways to contribute</h2>
        <p class="text-text-secondary max-w-[480px]">Every skill level welcome. Pick your entry point.</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(260px,1fr))] gap-5">
        {[
          {
            icon: '🔧',
            title: 'Build with us',
            description: 'Open a PR on an existing project, tackle an open issue, or propose something entirely new.',
            cta: 'Browse GitHub',
            href: GITHUB_ORG,
            external: true,
          },
          {
            icon: '💡',
            title: 'Share an idea',
            description: 'Have an idea for a project or feature? Open a discussion or issue on GitHub.',
            cta: 'Open a Discussion',
            href: GITHUB_REPO_DISCUSSIONS,
            external: true,
          },
          {
            icon: '📣',
            title: 'Spread the word',
            description: 'Star the repos, share with your network, or write about what we&apos;re building.',
            cta: 'Star on GitHub',
            href: GITHUB_REPO,
            external: true,
          },
        ].map(({ icon, title, description, cta, href, external }) => (
          <div
            data-animate-child
            class="bg-bg-surface border border-border rounded-[var(--radius-card)] p-7 flex flex-col"
          >
            <div class="text-[2rem] mb-4">{icon}</div>
            <h3 class="text-text-primary text-[1.1rem] font-bold mb-2">{title}</h3>
            <p class="text-text-secondary text-[0.9rem] leading-relaxed flex-1 mb-6">{description}</p>
            <a
              href={href}
              target={external ? '_blank' : undefined}
              rel={external ? 'noopener noreferrer' : undefined}
              class="btn-ghost self-start"
              style="padding: 0.5rem 1.25rem; font-size: 0.875rem;"
            >
              {cta} {external ? '↗' : '→'}
            </a>
          </div>
        ))}
      </div>
    </div>
  </AnimatedSection>

  <!-- OPEN ISSUES -->
  <AnimatedSection class="py-6 bg-bg-surface">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div>
          <p class="text-accent-purple text-[0.8rem] font-semibold uppercase tracking-[0.08em] mb-3">Good first issues</p>
          <h2 class="font-extrabold tracking-[-0.02em] mb-4" style="font-size: clamp(1.5rem, 3vw, 2.25rem);">
            Jump right in
          </h2>
          <p class="text-text-secondary leading-[1.8] mb-8">
            Check out open issues on our repos — we tag beginner-friendly tasks so you can find your footing without any friction.
          </p>
          <a
            href={GITHUB_REPO_ISSUES}
            target="_blank"
            rel="noopener noreferrer"
            class="btn-primary"
          >
            View Open Issues ↗
          </a>
        </div>
        <div class="bg-bg-elevated border border-border rounded-[1rem] p-6 font-mono text-[0.82rem] leading-[1.9]">
          <p class="text-text-muted mb-2"># how to contribute</p>
          <p><span class="text-accent-cyan">1.</span> <span class="text-text-secondary">Fork the repo</span></p>
          <p><span class="text-accent-cyan">2.</span> <span class="text-text-secondary">Create a branch</span></p>
          <p><span class="text-accent-cyan">3.</span> <span class="text-text-secondary">Make your changes</span></p>
          <p><span class="text-accent-cyan">4.</span> <span class="text-text-secondary">Open a PR</span></p>
          <p><span class="text-accent-cyan">5.</span> <span class="text-accent-purple">Ship it 🚀</span></p>
        </div>
      </div>
    </div>
  </AnimatedSection>

  <!-- FINAL CTA -->
  <AnimatedSection class="py-16 text-center">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="font-extrabold tracking-[-0.02em] mb-4" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
        The door is <span class="gradient-text">always open.</span>
      </h2>
      <p class="text-text-secondary max-w-[440px] mx-auto mb-8 leading-[1.7]">
        You don't need permission to contribute. Just show up, build something, and share it.
      </p>
      <a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer" class="btn-primary">
        Start on GitHub ↗
      </a>
    </div>
  </AnimatedSection>
</BaseLayout>
