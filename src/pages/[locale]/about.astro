---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnimatedSection from '../../components/AnimatedSection.astro';
import ValuePill from '../../components/ValuePill.astro';
import { GITHUB_ORG } from '../../config';
import { t, locales, type Locale } from '../../i18n/index';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

// Astro.params on the /[locale]/ route; Astro.props when the root-level page
// renders this directly to serve the default locale.
const { locale } = { ...Astro.params, ...Astro.props } as { locale: Locale };
---

<BaseLayout
  title={t(locale, 'about.metaTitle')}
  description={t(locale, 'about.metaDescription')}
  locale={locale}>
  <!-- PAGE HERO -->
  <section class="pt-40 pb-20 text-center relative overflow-hidden animate-fade-up">
    <!-- radial-gradient background must stay inline -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(42, 181, 165, 0.1) 0%, transparent 70%);"
    ></div>
    <div class="max-w-[1280px] mx-auto px-6 relative">
      <p class="text-accent-purple text-[0.8rem] font-semibold uppercase tracking-[0.08em] mb-4">{t(locale, 'about.label')}</p>
      <h1 class="font-black tracking-[-0.03em] mb-6" style="font-size: clamp(2.25rem, 6vw, 4rem);">
        {t(locale, 'about.heroTitle')} <span class="gradient-text">{t(locale, 'about.heroTitleAccent')}</span>
      </h1>
      <p class="text-text-secondary max-w-[600px] mx-auto leading-[1.75]" style="font-size: clamp(1rem, 2vw, 1.2rem);">
        {t(locale, 'about.heroSubtitle')}
      </p>
    </div>
  </section>

  <!-- COMMUNITY APPROACH -->
  <AnimatedSection class="py-6">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="font-extrabold tracking-[-0.02em] mb-5" style="font-size: clamp(1.5rem, 3vw, 2.25rem);">
            {t(locale, 'about.originTitle')}<br />{t(locale, 'about.originTitleLine2')}
          </h2>
          <p class="text-text-secondary leading-[1.8] mb-4">{t(locale, 'about.originP1')}</p>
          <p class="text-text-secondary leading-[1.8] mb-4">{t(locale, 'about.originP2')}</p>
          <p class="text-text-secondary leading-[1.8]">{t(locale, 'about.originP3')}</p>
        </div>
        <div class="bg-bg-surface border border-border rounded-[1rem] p-8 font-mono text-[0.85rem] text-text-secondary leading-[1.8]">
          <p class="text-accent-purple mb-2"># {t(locale, 'about.approachLabel')}</p>
          {['Discover', 'Create', 'Share', 'Listen', 'Improve'].map((step) => (
            <p><span aria-hidden="true">→ </span>{t(locale, `about.approach${step}`)}</p>
          ))}
          <br />
          <p class="text-text-muted">{t(locale, 'about.approachNote')}</p>
        </div>
      </div>
    </div>
  </AnimatedSection>

  <!-- VALUES -->
  <AnimatedSection class="py-6 bg-bg-surface" group>
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="mb-10">
        <h2 class="font-extrabold tracking-[-0.02em] mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">{t(locale, 'about.valuesTitle')}</h2>
        <p class="text-text-secondary max-w-[480px]">{t(locale, 'about.valuesSubtitle')}</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4">
        <ValuePill icon="✨" title={t(locale, 'values.delightTitle')} description={t(locale, 'values.delightBody')} />
        <ValuePill icon="🔎" title={t(locale, 'values.discoverTitle')} description={t(locale, 'values.discoverBody')} />
        <ValuePill icon="🤝" title={t(locale, 'values.communityTitle')} description={t(locale, 'values.communityBody')} />
        <ValuePill icon="💬" title={t(locale, 'values.listenTitle')} description={t(locale, 'values.listenBody')} />
      </div>
    </div>
  </AnimatedSection>

  <!-- GITHUB CTA -->
  <AnimatedSection class="py-16 text-center">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="font-extrabold tracking-[-0.02em] mb-4" style="font-size: clamp(1.5rem, 3vw, 2.25rem);">
        {t(locale, 'about.githubTitle')} <span class="gradient-text">{t(locale, 'about.githubTitleAccent')}</span>
      </h2>
      <p class="text-text-secondary max-w-[440px] mx-auto mb-8 leading-[1.7]">
        {t(locale, 'about.githubBody')}
      </p>
      <a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer" class="btn-primary">
        {t(locale, 'about.githubCta')}
      </a>
    </div>
  </AnimatedSection>
</BaseLayout>
