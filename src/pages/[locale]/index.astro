---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnimatedSection from '../../components/AnimatedSection.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ValuePill from '../../components/ValuePill.astro';
import { GITHUB_ORG, GITHUB_REPO } from '../../config';
import { t, locales, localizedPath, type Locale } from '../../i18n/index';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

const { locale } = Astro.params as { locale: Locale };
---

<BaseLayout
  title={t(locale, 'home.heroTitle')}
  description={t(locale, 'site.tagline')}
  locale={locale}
>
  <!-- HERO -->
  <section class="min-h-screen flex items-center pt-20 relative overflow-hidden animate-fade-up">
    <!-- background glow — radial-gradient must stay inline -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 80% 60% at 50% 40%, rgba(42, 181, 165, 0.12) 0%, transparent 70%);"
    ></div>

    <div class="max-w-[1280px] mx-auto px-6 relative text-center">
      <img src="/logo.png" alt="ExAI" class="h-24 w-24 object-contain mx-auto mb-6" />

      <div class="inline-flex items-center gap-2 bg-accent-purple/10 border border-accent-purple/25 rounded-full px-4 py-1.5 text-[0.8rem] font-semibold text-accent-purple mb-8 uppercase tracking-[0.05em]">
        Open Collective · Open Source
      </div>

      <h1
        class="font-black leading-[1.05] tracking-[-0.03em] mb-6 text-text-primary"
        style="font-size: clamp(2.75rem, 8vw, 5.5rem);"
      >
        {t(locale, 'home.heroTitle')}<br /><span class="gradient-text">{t(locale, 'home.heroTitleAccent')}</span>
      </h1>

      <p
        class="text-text-secondary max-w-[600px] mx-auto mb-10 leading-[1.7]"
        style="font-size: clamp(1rem, 2.5vw, 1.25rem);"
      >
        {t(locale, 'home.heroSubtitle')}
      </p>

      <div class="flex gap-4 justify-center flex-wrap">
        <a href={localizedPath('/projects', locale)} class="btn-primary">{t(locale, 'home.ctaProjects')}</a>
        <a href={localizedPath('/get-involved', locale)} class="btn-ghost">{t(locale, 'home.ctaInvolved')}</a>
      </div>
    </div>
  </section>

  <!-- STATS STRIP -->
  <AnimatedSection class="border-t border-b border-border py-8">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="flex flex-wrap justify-center gap-12">
        {[
          { label: t(locale, 'home.stat1Label'), value: t(locale, 'home.stat1Value') },
          { label: t(locale, 'home.stat2Label'), value: t(locale, 'home.stat2Value') },
          { label: t(locale, 'home.stat3Label'), value: t(locale, 'home.stat3Value') },
          { label: t(locale, 'home.stat4Label'), value: t(locale, 'home.stat4Value') },
        ].map(({ label, value }) => (
          <div class="text-center">
            <div class="text-[1.75rem] font-black text-accent-purple">{value}</div>
            <div class="text-[0.8rem] text-text-muted mt-1 uppercase tracking-[0.05em]">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </AnimatedSection>

  <!-- FEATURED PROJECT -->
  <AnimatedSection class="py-6">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="mb-10">
        <p class="text-accent-purple text-[0.8rem] font-semibold uppercase tracking-[0.08em] mb-3">{t(locale, 'home.featuredLabel')}</p>
        <h2 class="font-extrabold tracking-[-0.02em] mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">{t(locale, 'home.featuredTitle')}</h2>
        <p class="text-text-secondary max-w-[520px]">{t(locale, 'home.featuredSubtitle')}</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,480px),1fr))] gap-5" data-animate-group>
        <ProjectCard
          name={t(locale, 'projects.odrName')}
          description={t(locale, 'projects.odrDescription')}
          href={GITHUB_REPO}
          tags={["Python", "Preact", "AI Agents", "Streaming"]}
          status="live"
        />
      </div>
      <div class="mt-8">
        <a href={localizedPath('/projects', locale)} class="btn-ghost">{t(locale, 'home.viewAllProjects')}</a>
      </div>
    </div>
  </AnimatedSection>

  <!-- VALUES -->
  <AnimatedSection class="py-6 bg-bg-surface" group>
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="mb-10 text-center">
        <h2 class="font-extrabold tracking-[-0.02em] mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">{t(locale, 'home.valuesTitle')}</h2>
        <p class="text-text-secondary max-w-[480px] mx-auto">{t(locale, 'home.valuesSubtitle')}</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4">
        <ValuePill icon="⚡" title={t(locale, 'values.learnTitle')} description={t(locale, 'values.learnBody')} />
        <ValuePill icon="🔓" title={t(locale, 'values.openTitle')} description={t(locale, 'values.openBody')} />
        <ValuePill icon="🤝" title={t(locale, 'values.communityTitle')} description={t(locale, 'values.communityBody')} />
        <ValuePill icon="🛠️" title={t(locale, 'values.freeTitle')} description={t(locale, 'values.freeBody')} />
      </div>
    </div>
  </AnimatedSection>

  <!-- GET INVOLVED CTA -->
  <AnimatedSection class="py-16">
    <div class="max-w-[1280px] mx-auto px-6 text-center">
      <div
        class="border border-[var(--color-border-accent)] rounded-[1.25rem]"
        style="background: linear-gradient(135deg, rgba(42, 181, 165, 0.12), rgba(245, 130, 31, 0.08)); padding: clamp(2rem, 6vw, 4rem);"
      >
        <h2 class="font-extrabold tracking-[-0.02em] mb-4" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
          {t(locale, 'home.ctaTitle')} <span class="gradient-text">{t(locale, 'home.ctaTitleAccent')}</span>
        </h2>
        <p class="text-text-secondary max-w-[480px] mx-auto mb-8 leading-[1.7]">
          {t(locale, 'home.ctaBody')}
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a href={localizedPath('/get-involved', locale)} class="btn-primary">{t(locale, 'home.ctaGetInvolved')}</a>
          <a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer" class="btn-ghost">{t(locale, 'home.ctaGithub')}</a>
        </div>
      </div>
    </div>
  </AnimatedSection>
</BaseLayout>
