---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import HeroTerminal from '../../components/HeroTerminal';
import { terminalCopy } from '../../components/terminal-copy';
import type { TerminalFile } from '../../lib/terminal';
import AnimatedSection from '../../components/AnimatedSection.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ValuePill from '../../components/ValuePill.astro';
import { GITHUB_ORG } from '../../config';
import { fetchProjects, localize } from '../../lib/github';
import { t, locales, localizedPath, type Locale } from '../../i18n/index';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

// Astro.params on the /[locale]/ route; Astro.props when the root index.astro
// renders this directly to serve the default locale at /.
const { locale } = { ...Astro.params, ...Astro.props } as { locale: Locale };

// fetchProjects sorts by stars, so the most-starred repo leads the homepage.
const [projects, allPosts] = await Promise.all([fetchProjects(), getCollection('blog')]);
const featured = localize(projects[0], locale);
const copy = terminalCopy[locale];
const posts = allPosts.filter((post) => post.data.locale === locale)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
const files: TerminalFile[] = [
  { path: '/', title: 'ExAI', body: '', directory: true, href: localizedPath('/', locale) },
  { path: '/blog', title: t(locale, 'nav.blog'), body: '', directory: true, href: localizedPath('/blog', locale) },
  { path: '/projects', title: t(locale, 'nav.projects'), body: '', directory: true, href: localizedPath('/projects', locale) },
  { path: '/about', title: t(locale, 'nav.about'), body: '', directory: true, href: localizedPath('/about', locale) },
  { path: '/get-involved', title: t(locale, 'nav.getInvolved'), body: '', directory: true, href: localizedPath('/get-involved', locale) },
  { path: '/games', title: copy.arcade, body: '', directory: true },
  { path: '/README.md', title: 'Hello, world.', body: `# Extracurricular AI\n\n${t(locale, 'home.heroSubtitle')}\n\n${copy.hint}\n\nls blog/\nls projects/\nplay invaders`, href: localizedPath('/about', locale) },
  { path: '/about/README.md', title: t(locale, 'nav.about'), body: `${t(locale, 'about.heroSubtitle')}\n\n${t(locale, 'about.originP1')}\n\n${t(locale, 'about.originP2')}\n\n${t(locale, 'about.originP3')}`, href: localizedPath('/about', locale) },
  { path: '/get-involved/README.md', title: t(locale, 'nav.getInvolved'), body: `${t(locale, 'getInvolved.heroSubtitle')}\n\n${t(locale, 'getInvolved.card1Title')}\n${t(locale, 'getInvolved.card1Body')}\n\n${t(locale, 'getInvolved.card2Title')}\n${t(locale, 'getInvolved.card2Body')}`, href: localizedPath('/get-involved', locale) },
  { path: '/games/invaders', title: copy.arcade, body: `${copy.gameIntro}\n\n${copy.manuals.play}\n${copy.gameHint}` },
  { path: '/.secret', title: 'psst…', body: copy.secret },
  ...posts.map((post) => {
    const slug = post.id.split('/').pop()!.replace(/\.md$/, '');
    return { path: `/blog/${slug}.md`, title: post.data.title, body: `# ${post.data.title}\n${post.data.pubDate.toISOString().slice(0, 10)} · ${post.data.author}\n\n${post.body}`, href: localizedPath(`/blog/${slug}`, post.data.locale) };
  }),
  ...projects.map((project) => {
    const localized = localize(project, locale);
    return { path: `/projects/${project.slug}.md`, title: localized.name, body: `# ${localized.name}\n\n${localized.description}\n\n${project.topics.join(' · ')}\n${project.href}`, href: project.href };
  }),
];
---

<BaseLayout
  title={t(locale, 'home.heroTitle')}
  description={t(locale, 'site.tagline')}
  locale={locale}
>
  <!-- HERO -->
  <section class="home-playground animate-fade-up">
    <div class="home-playground-grid">
      <div class="home-intro">
        <div class="home-brand">
          <img src="/logo.png" alt="ExAI" width="44" height="44" />
          <span>{t(locale, 'home.badge')}</span>
        </div>
        <h1>{t(locale, 'home.heroTitle')}<br />{' '}<span class="gradient-text">{t(locale, 'home.heroTitleAccent')}</span></h1>
        <p>{t(locale, 'home.heroSubtitle')}</p>
        <div class="home-intro-actions">
          <a href={localizedPath('/projects', locale)} class="btn-primary">{t(locale, 'home.ctaProjects')} ↗</a>
          <a href={localizedPath('/get-involved', locale)} class="btn-ghost">{t(locale, 'home.ctaInvolved')}</a>
        </div>
        <div class="home-explore-note"><span aria-hidden="true">↳</span><span>{copy.intro}</span></div>
      </div>
      <HeroTerminal client:load files={files} locale={locale} />
    </div>
  </section>

  <!-- STATS STRIP -->
  <AnimatedSection class="border-t border-b border-border py-8">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="flex flex-wrap justify-center gap-12">
        {[
          { label: t(locale, 'home.stat1Label'), value: t(locale, 'home.stat1Value') },
          { label: t(locale, 'home.stat2Label'), value: t(locale, 'home.stat2Value') },
          { label: t(locale, 'home.stat3Label'), value: t(locale, 'home.stat3Value') },
          { label: t(locale, 'home.stat4Label'), value: t(locale, 'home.stat4Value') },
        ].map(({ label, value }) => (
          <div class="text-center">
            <div class="text-[1.75rem] font-black text-accent-purple">{value}</div>
            <div class="text-[0.8rem] text-text-muted mt-1 uppercase tracking-[0.05em]">{label}</div>
          </div>
        ))}
      </div>
    </div>
  </AnimatedSection>

  <!-- FEATURED PROJECT -->
  <AnimatedSection class="py-6">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="mb-10">
        <p class="text-accent-purple text-[0.8rem] font-semibold uppercase tracking-[0.08em] mb-3">{t(locale, 'home.featuredLabel')}</p>
        <h2 class="font-extrabold tracking-[-0.02em] mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">{t(locale, 'home.featuredTitle')}</h2>
        <p class="text-text-secondary max-w-[520px]">{t(locale, 'home.featuredSubtitle')}</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(min(100%,480px),1fr))] gap-5" data-animate-group>
        <ProjectCard
          name={featured.name}
          description={featured.description}
          href={featured.href}
          tags={featured.topics}
          stars={featured.stars}
          language={featured.language}
          status={featured.status}
        />
      </div>
      <div class="mt-8">
        <a href={localizedPath('/projects', locale)} class="btn-ghost">{t(locale, 'home.viewAllProjects')}</a>
      </div>
    </div>
  </AnimatedSection>

  <!-- VALUES -->
  <AnimatedSection class="py-6 bg-bg-surface" group>
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="mb-10 text-center">
        <h2 class="font-extrabold tracking-[-0.02em] mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">{t(locale, 'home.valuesTitle')}</h2>
        <p class="text-text-secondary max-w-[480px] mx-auto">{t(locale, 'home.valuesSubtitle')}</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4">
        <ValuePill icon="⚡" title={t(locale, 'values.learnTitle')} description={t(locale, 'values.learnBody')} />
        <ValuePill icon="🔓" title={t(locale, 'values.openTitle')} description={t(locale, 'values.openBody')} />
        <ValuePill icon="🤝" title={t(locale, 'values.communityTitle')} description={t(locale, 'values.communityBody')} />
        <ValuePill icon="🛠️" title={t(locale, 'values.freeTitle')} description={t(locale, 'values.freeBody')} />
      </div>
    </div>
  </AnimatedSection>

  <!-- GET INVOLVED CTA -->
  <AnimatedSection class="py-16">
    <div class="max-w-[1280px] mx-auto px-6 text-center">
      <div
        class="border border-[var(--color-border-accent)] rounded-[1.25rem]"
        style="background: linear-gradient(135deg, rgba(42, 181, 165, 0.12), rgba(245, 130, 31, 0.08)); padding: clamp(2rem, 6vw, 4rem);"
      >
        <h2 class="font-extrabold tracking-[-0.02em] mb-4" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
          {t(locale, 'home.ctaTitle')} <span class="gradient-text">{t(locale, 'home.ctaTitleAccent')}</span>
        </h2>
        <p class="text-text-secondary max-w-[480px] mx-auto mb-8 leading-[1.7]">
          {t(locale, 'home.ctaBody')}
        </p>
        <div class="flex gap-4 justify-center flex-wrap">
          <a href={localizedPath('/get-involved', locale)} class="btn-primary">{t(locale, 'home.ctaGetInvolved')}</a>
          <a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer" class="btn-ghost">{t(locale, 'home.ctaGithub')}</a>
        </div>
      </div>
    </div>
  </AnimatedSection>
</BaseLayout>
