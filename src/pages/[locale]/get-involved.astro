---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { t, locales, type Locale } from '../../i18n/index';
interface Props { locale?: Locale }
export function getStaticPaths() { return locales.map((locale) => ({ params: { locale } })); }
const { locale } = { ...Astro.params, ...Astro.props } as { locale: Locale };
---
<BaseLayout title={t(locale, 'getInvolved.metaTitle')} description={t(locale, 'getInvolved.metaDescription')} locale={locale} desktopApp="get-involved" />
