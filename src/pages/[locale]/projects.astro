---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AnimatedSection from '../../components/AnimatedSection.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { COMMUNITY_DISCUSSION_URL } from '../../config';
import { fetchProjects, localize } from '../../lib/github';
import { t, locales, localizedPath, type Locale } from '../../i18n/index';

export function getStaticPaths() {
  return locales.map((locale) => ({ params: { locale } }));
}

// Astro.params on the /[locale]/ route; Astro.props when the root-level page
// renders this directly to serve the default locale.
const { locale } = { ...Astro.params, ...Astro.props } as { locale: Locale };

const projects = (await fetchProjects()).map((p) => localize(p, locale));
---

<BaseLayout
  title={t(locale, 'projects.metaTitle')}
  description={t(locale, 'projects.metaDescription')}
  locale={locale}>
  <!-- PAGE HERO -->
  <section class="pt-40 pb-20 relative overflow-hidden animate-fade-up">
    <!-- radial-gradient background must stay inline -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(245, 130, 31, 0.07) 0%, transparent 70%);"
    ></div>
    <div class="max-w-[1280px] mx-auto px-6 relative">
      <p class="text-accent-cyan text-[0.8rem] font-semibold uppercase tracking-[0.08em] mb-4">{t(locale, 'projects.label')}</p>
      <h1 class="font-black tracking-[-0.03em] mb-6" style="font-size: clamp(2.25rem, 6vw, 4rem);">
        {t(locale, 'projects.heroTitle')} <span class="gradient-text">{t(locale, 'projects.heroTitleAccent')}</span>
      </h1>
      <p class="text-text-secondary max-w-[560px] leading-[1.75]" style="font-size: clamp(1rem, 2vw, 1.2rem);">
        {t(locale, 'projects.heroSubtitle')}
      </p>
    </div>
  </section>

  <!-- LIVE PROJECTS -->
  <AnimatedSection class="py-6">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="text-[1.1rem] font-semibold text-text-muted uppercase tracking-[0.08em] mb-6">
        {t(locale, 'projects.liveLabel')}
      </h2>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,480px),1fr))] gap-5" data-animate-group>
        {projects.map((project) => (
          <ProjectCard
            name={project.name}
            description={project.description}
            href={project.href}
            tags={project.topics}
            stars={project.stars}
            language={project.language}
            status={project.status}
          />
        ))}
      </div>
    </div>
  </AnimatedSection>

  {(locale === 'en' || locale === 'zh') && (
    <section class="max-w-[1280px] mx-auto px-6 py-8">
      <h2 class="text-text-primary font-bold text-xl mb-3">DSH Rewind &amp; Redo — by FileSnap</h2>
      <p class="text-text-secondary leading-relaxed mb-3">
        {locale === 'zh'
          ? '了解如何回退 DeepSeek Harness 对话与已追踪文件，以及如何用 /redo 撤销回退。'
          : 'Learn to rewind a DeepSeek Harness conversation and its tracked files, then reverse the rewind with /redo.'}
      </p>
      <div class="flex flex-wrap gap-x-6 gap-y-3">
        <a class="text-accent-cyan underline" href={localizedPath('/blog/dsh-rewind-restore-files/', locale)}>
          {locale === 'zh' ? '安装与使用教程' : 'Installation and tutorial'}
        </a>
        <a class="text-accent-cyan underline" href={localizedPath('/blog/dsh-rewind-plugin-comparison/', locale)}>
          {locale === 'zh' ? '回退插件选型比较' : 'Compare rewind plugins'}
        </a>
      </div>
    </section>
  )}

  <!-- MORE TO COME -->
  <AnimatedSection class="py-6">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="text-[1.1rem] font-semibold text-text-muted uppercase tracking-[0.08em] mb-6">
        {t(locale, 'projects.comingLabel')}
      </h2>
      <div class="grid grid-cols-[repeat(auto-fill,minmax(min(100%,480px),1fr))] gap-5" data-animate-group>
        <a href={COMMUNITY_DISCUSSION_URL} target="_blank" rel="noopener noreferrer" data-animate-child
          class="block bg-bg-surface border border-border rounded-[var(--radius-card)] p-7 no-underline hover:border-accent-purple">
          <h3 class="text-text-primary text-[1.1rem] font-bold mb-3">{t(locale, 'projects.comingName')}</h3>
          <p class="text-text-secondary text-[0.9rem] leading-relaxed mb-4">{t(locale, 'projects.comingDescription')}</p>
          <span class="text-accent-purple">{t(locale, 'getInvolved.card2Cta')} ↗</span>
        </a>
      </div>
    </div>
  </AnimatedSection>

  <!-- CONTRIBUTE CTA -->
  <AnimatedSection class="py-16 bg-bg-surface">
    <div class="max-w-[1280px] mx-auto px-6 text-center">
      <h2 class="font-extrabold tracking-[-0.02em] mb-4" style="font-size: clamp(1.5rem, 3vw, 2.25rem);">
        {t(locale, 'projects.contributeTitle')} <span class="gradient-text">{t(locale, 'projects.contributeTitleAccent')}</span>
      </h2>
      <p class="text-text-secondary max-w-[440px] mx-auto mb-8 leading-[1.7]">
        {t(locale, 'projects.contributeBody')}
      </p>
      <a href={localizedPath('/get-involved', locale)} class="btn-primary">{t(locale, 'projects.contributeCta')}</a>
    </div>
  </AnimatedSection>
</BaseLayout>
