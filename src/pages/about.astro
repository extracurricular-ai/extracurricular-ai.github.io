---
import BaseLayout from '../layouts/BaseLayout.astro';
import AnimatedSection from '../components/AnimatedSection.astro';
import ValuePill from '../components/ValuePill.astro';
import { GITHUB_ORG } from '../config';
---

<BaseLayout
  title="About"
  description="Extracurricular AI is an open collective of builders exploring AI through hands-on experimentation."
>
  <!-- PAGE HERO -->
  <section class="pt-40 pb-20 text-center relative overflow-hidden animate-fade-up">
    <!-- radial-gradient background must stay inline -->
    <div
      class="absolute inset-0 pointer-events-none"
      style="background: radial-gradient(ellipse 60% 50% at 50% 0%, rgba(42, 181, 165, 0.1) 0%, transparent 70%);"
    ></div>
    <div class="max-w-[1280px] mx-auto px-6 relative">
      <p class="text-accent-purple text-[0.8rem] font-semibold uppercase tracking-[0.08em] mb-4">About ExAI</p>
      <h1 class="font-black tracking-[-0.03em] mb-6" style="font-size: clamp(2.25rem, 6vw, 4rem);">
        Who <span class="gradient-text">we are</span>
      </h1>
      <p class="text-text-secondary max-w-[600px] mx-auto leading-[1.75]" style="font-size: clamp(1rem, 2vw, 1.2rem);">
        Extracurricular AI is an open collective of builders, tinkerers, and learners who believe the best way to understand AI is to build real things with it — and share everything along the way.
      </p>
    </div>
  </section>

  <!-- ORIGIN STORY -->
  <AnimatedSection class="py-6">
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-16 items-center">
        <div>
          <h2 class="font-extrabold tracking-[-0.02em] mb-5" style="font-size: clamp(1.5rem, 3vw, 2.25rem);">
            Born from curiosity,<br />built in public
          </h2>
          <p class="text-text-secondary leading-[1.8] mb-4">
            ExAI started as a group of builders who wanted to learn AI by building real things — not just reading papers or watching tutorials, but shipping actual software.
          </p>
          <p class="text-text-secondary leading-[1.8] mb-4">
            We're not affiliated with any company or institution. We're just people who are genuinely excited about AI and want to explore it together, in the open.
          </p>
          <p class="text-text-secondary leading-[1.8]">
            Everything we build is open source. Everything we learn gets shared. That's the deal.
          </p>
        </div>
        <div class="bg-bg-surface border border-border rounded-[1rem] p-8 font-mono text-[0.85rem] text-text-secondary leading-[1.8]">
          <p class="text-accent-purple mb-2"># our approach</p>
          <p>$ git clone [idea]</p>
          <p>$ cd idea && ship it</p>
          <p>$ open-source --everything</p>
          <p>$ share --with community</p>
          <p>$ repeat</p>
          <br />
          <p class="text-text-muted"># no gatekeeping. no paywalls.</p>
          <p class="text-text-muted"># just building.</p>
        </div>
      </div>
    </div>
  </AnimatedSection>

  <!-- VALUES -->
  <AnimatedSection class="py-6 bg-bg-surface" group>
    <div class="max-w-[1280px] mx-auto px-6">
      <div class="mb-10">
        <h2 class="font-extrabold tracking-[-0.02em] mb-3" style="font-size: clamp(1.75rem, 4vw, 2.5rem);">Our values</h2>
        <p class="text-text-secondary max-w-[480px]">These aren't mission statement buzzwords. They're how we actually operate.</p>
      </div>
      <div class="grid grid-cols-[repeat(auto-fit,minmax(220px,1fr))] gap-4">
        <ValuePill icon="⚡" title="Learn by Shipping" description="The fastest way to understand something is to build it. Theory without practice is just trivia." />
        <ValuePill icon="🔓" title="Open Source" description="Code, ideas, mistakes — all of it is public. Transparency makes better builders." />
        <ValuePill icon="🤝" title="Community First" description="We're stronger together. Every contributor, at every level, belongs here." />
        <ValuePill icon="🛠️" title="Free Forever" description="Our tools stay free. Knowledge and tooling shouldn't be locked behind a paywall." />
      </div>
    </div>
  </AnimatedSection>

  <!-- GITHUB CTA -->
  <AnimatedSection class="py-16 text-center">
    <div class="max-w-[1280px] mx-auto px-6">
      <h2 class="font-extrabold tracking-[-0.02em] mb-4" style="font-size: clamp(1.5rem, 3vw, 2.25rem);">
        Find us on <span class="gradient-text">GitHub</span>
      </h2>
      <p class="text-text-secondary max-w-[440px] mx-auto mb-8 leading-[1.7]">
        All of our projects, discussions, and code live in the open at github.com/extracurricular-ai.
      </p>
      <a href={GITHUB_ORG} target="_blank" rel="noopener noreferrer" class="btn-primary">
        Visit us on GitHub ↗
      </a>
    </div>
  </AnimatedSection>
</BaseLayout>
