---
import '../styles/global.css';
import Desktop from '../components/desktop/Desktop.astro';
import '../styles/desktop.css';

import { locales, localeNames, localizedPath, t, defaultLocale, type Locale } from '../i18n/index';

interface Props {
  title: string;
  desktopApp?: string;
  description?: string;
  locale?: string;
  image?: string;
  imageAlt?: string;
  article?: { author: string; publishedAt: string };
  translationLocales?: Locale[];
}

const { title, locale = defaultLocale } = Astro.props;
const description = Astro.props.description ?? t(locale, 'site.tagline');

const SITE = Astro.site ?? 'https://extracurricular.ai';

// The default locale is served at both / and /en/. Canonicalizing on the
// prefixed form keeps the two from competing as separate pages, and matches
// the hreflang="en" target below.
const canonicalURL = new URL(localizedPath(Astro.url.pathname, locale as (typeof locales)[number]), SITE);

const availableLocales = Astro.props.translationLocales ?? [...locales];
const hreflangLinks = availableLocales.map((loc) => ({
  locale: loc,
  href: new URL(localizedPath(Astro.url.pathname, loc), SITE).toString(),
}));
const xDefaultLocale = availableLocales.includes(defaultLocale) ? defaultLocale : availableLocales[0] ?? defaultLocale;
const xDefaultHref = new URL(localizedPath(Astro.url.pathname, xDefaultLocale), SITE).toString();
const imageURL = Astro.props.image ? new URL(Astro.props.image, SITE).toString() : undefined;

const switcherLinks = locales.map((loc) => ({
  locale: loc,
  label: localeNames[loc],
  href: localizedPath(availableLocales.includes(loc) ? Astro.url.pathname : '/blog', loc),
  active: loc === locale,
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonicalURL} />

    {hreflangLinks.map(({ locale: loc, href }) => (
      <link rel="alternate" hreflang={loc} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <title>{title} | ExAI</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={Astro.props.article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ExAI`} />
    <meta property="og:description" content={description} />
    {imageURL && <meta property="og:image" content={imageURL} />}
    {imageURL && Astro.props.imageAlt && <meta property="og:image:alt" content={Astro.props.imageAlt} />}
    {Astro.props.article && <meta property="article:published_time" content={Astro.props.article.publishedAt} />}
    {Astro.props.article && <meta name="author" content={Astro.props.article.author} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ExAI`} />
    <meta name="twitter:description" content={description} />
    {imageURL && <meta name="twitter:image" content={imageURL} />}
    {imageURL && Astro.props.imageAlt && <meta name="twitter:image:alt" content={Astro.props.imageAlt} />}

  </head>
  <body>
    <Desktop locale={locale as Locale} activeApp={Astro.props.desktopApp ?? 'article'} title={title} switcherLinks={switcherLinks}>
      <slot />
    </Desktop>
  </body>
</html>
