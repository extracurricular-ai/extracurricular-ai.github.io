---
import '../styles/global.css';
import Nav from '../components/Nav.tsx';
import Footer from '../components/Footer.astro';
import { locales, localeNames, localizedPath, t, defaultLocale } from '../i18n/index';

interface Props {
  title: string;
  description?: string;
  locale?: string;
}

const { title, locale = defaultLocale } = Astro.props;
const description = Astro.props.description ?? t(locale, 'site.tagline');

const canonicalURL = new URL(Astro.url.pathname, Astro.site ?? 'https://extracurricularai.org');

const hreflangLinks = locales.map((loc) => ({
  locale: loc,
  href: new URL(localizedPath(Astro.url.pathname, loc), Astro.site ?? 'https://extracurricularai.org').toString(),
}));
const xDefaultHref = new URL(localizedPath(Astro.url.pathname, 'en'), Astro.site ?? 'https://extracurricularai.org').toString();

const navLabels = {
  home: t(locale, 'nav.home'),
  about: t(locale, 'nav.about'),
  projects: t(locale, 'nav.projects'),
  getInvolved: t(locale, 'nav.getInvolved'),
  github: t(locale, 'nav.github'),
  switchLanguage: t(locale, 'nav.switchLanguage'),
};

const switcherLinks = locales.map((loc) => ({
  locale: loc,
  label: localeNames[loc],
  href: localizedPath(Astro.url.pathname, loc),
  active: loc === locale,
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonicalURL} />

    {hreflangLinks.map(({ locale: loc, href }) => (
      <link rel="alternate" hreflang={loc} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <title>{title} | ExAI</title>
    <meta name="description" content={description} />

    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ExAI`} />
    <meta property="og:description" content={description} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ExAI`} />
    <meta name="twitter:description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Nav client:load currentLocale={locale} currentPath={Astro.url.pathname} labels={navLabels} switcherLinks={switcherLinks} />
    <main class="flex-1">
      <slot />
    </main>
    <Footer locale={locale} />
    <script>
      import '../scripts/animations.ts';
    </script>
  </body>
</html>
