---
import '../styles/global.css';
import Desktop from '../components/desktop/Desktop.astro';
import '../styles/desktop.css';
import { getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import socialCard from '../assets/social-card.png';

import { locales, localeNames, localizedPath, t, defaultLocale, type Locale } from '../i18n/index';

interface Props {
  title: string;
  desktopApp?: string;
  description?: string;
  locale?: string;
  image?: ImageMetadata;
  imageAlt?: string;
  article?: { author: string; publishedAt: string; modifiedAt?: string };
  translationLocales?: Locale[];
}

const { title, locale = defaultLocale } = Astro.props;
const description = Astro.props.description ?? t(locale, 'site.tagline');

const SITE = Astro.site ?? 'https://extracurricular.ai';

// The default locale is served at both / and /en/. Canonicalizing on the
// prefixed form keeps the two from competing as separate pages, and matches
// the hreflang="en" target below.
const canonicalURL = new URL(localizedPath(Astro.url.pathname, locale as (typeof locales)[number]), SITE);

const availableLocales = Astro.props.translationLocales ?? [...locales];
const hreflangLinks = availableLocales.map((loc) => ({
  locale: loc,
  href: new URL(localizedPath(Astro.url.pathname, loc), SITE).toString(),
}));
const xDefaultLocale = availableLocales.includes(defaultLocale) ? defaultLocale : availableLocales[0] ?? defaultLocale;
const xDefaultHref = new URL(localizedPath(Astro.url.pathname, xDefaultLocale), SITE).toString();
const shareImage = await getImage({ src: Astro.props.image ?? socialCard, width: 1200, format: Astro.props.image ? 'jpg' : 'png', quality: 80 });
const imageURL = new URL(shareImage.src, SITE).toString();
const imageAlt = Astro.props.imageAlt ?? 'ExAI — Open-source software, tools, tutorials, and a curious community.';
const siteURL = new URL('/', SITE).href;
const organizationId = `${siteURL}#organization`;
const websiteId = `${siteURL}#website`;
const article = Astro.props.article;
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Organization', '@id': organizationId, name: 'Extracurricular AI', alternateName: 'ExAI',
      url: siteURL, logo: new URL('/logo.png', SITE).href, sameAs: ['https://github.com/extracurricular-ai'] },
    { '@type': 'WebSite', '@id': websiteId, url: siteURL, name: 'ExAI', alternateName: 'Extracurricular AI', publisher: { '@id': organizationId } },
    ...(article ? [
      { '@type': 'BlogPosting', '@id': `${canonicalURL.href}#article`, headline: title, description,
        url: canonicalURL.href, mainEntityOfPage: canonicalURL.href, inLanguage: locale,
        image: [imageURL], datePublished: article.publishedAt,
        ...(article.modifiedAt ? { dateModified: article.modifiedAt } : {}),
        author: article.author === 'ExAI Team'
          ? { '@type': 'Organization', '@id': organizationId, name: article.author }
          : { '@type': 'Person', name: article.author },
        publisher: { '@id': organizationId }, isPartOf: { '@id': websiteId } },
      { '@type': 'BreadcrumbList', itemListElement: [
        { '@type': 'ListItem', position: 1, name: t(locale, 'nav.home'), item: new URL(localizedPath('/', locale as Locale), SITE).href },
        { '@type': 'ListItem', position: 2, name: t(locale, 'nav.blog'), item: new URL(localizedPath('/blog/', locale as Locale), SITE).href },
        { '@type': 'ListItem', position: 3, name: title, item: canonicalURL.href },
      ] },
    ] : []),
  ],
};

const switcherLinks = locales.map((loc) => ({
  locale: loc,
  label: localeNames[loc],
  href: localizedPath(availableLocales.includes(loc) ? Astro.url.pathname : '/blog', loc),
  active: loc === locale,
}));
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="google-adsense-account" content="ca-pub-4514332323196968" />
    <link rel="icon" type="image/png" href="/logo.png" />
    <link rel="canonical" href={canonicalURL} />

    {hreflangLinks.map(({ locale: loc, href }) => (
      <link rel="alternate" hreflang={loc} href={href} />
    ))}
    <link rel="alternate" hreflang="x-default" href={xDefaultHref} />

    <title>{title} | ExAI</title>
    <meta name="description" content={description} />

    <meta property="og:type" content={Astro.props.article ? 'article' : 'website'} />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | ExAI`} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content="ExAI" />
    <meta property="og:image" content={imageURL} />
    <meta property="og:image:width" content={shareImage.attributes.width} />
    <meta property="og:image:height" content={shareImage.attributes.height} />
    <meta property="og:image:alt" content={imageAlt} />
    {Astro.props.article && <meta property="article:published_time" content={Astro.props.article.publishedAt} />}
    {Astro.props.article && <meta name="author" content={Astro.props.article.author} />}
    {article?.modifiedAt && <meta property="article:modified_time" content={article.modifiedAt} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | ExAI`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageURL} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />

  </head>
  <body>
    <Desktop locale={locale as Locale} activeApp={Astro.props.desktopApp ?? 'article'} title={title} switcherLinks={switcherLinks}>
      <slot />
    </Desktop>
  </body>
</html>
